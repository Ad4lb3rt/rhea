---
import Layout from "../layouts/Layout.astro";
import CopyIcon from "../assets/CopyIcon.svg";
import MorphIcon from "morphicons/astro";
import { Copy } from "lucide";
---

<Layout>
    <div class="content">
        <div class="inputs-container">
            <div class="inputs">
                <label for="number-input">input</label>
                <textarea rows="1" id="number-input"></textarea>
            </div>
            <div class="inputs">
                <label for="base-input">base</label>
                <input
                    id="base-input"
                    type="number"
                    min="2"
                    max="36"
                    placeholder="2 - 36"
                    value="10"
                />
            </div>
        </div>

        <div class="outputs">
            <div class="output">
                <label for="binary-output">Binary</label>
                <div id="binary-output" class="output-value">00000000</div>
                <button class="copy-button" type="button" aria-label="Copy">
                    <MorphIcon icon={Copy} color="lightgray" />
                </button>
            </div>

            <div class="output">
                <label for="octal-output">Octal</label>
                <div id="octal-output" class="output-value">00000000</div>
                <button class="copy-button" type="button" aria-label="Copy">
                    <MorphIcon icon={Copy} color="lightgray" />
                </button>
            </div>

            <div class="output">
                <label for="decimal-output">Decimal</label>
                <div id="decimal-output" class="output-value">00000000</div>
                <button class="copy-button" type="button" aria-label="Copy">
                    <MorphIcon icon={Copy} color="lightgray" />
                </button>
            </div>

            <div class="output">
                <label for="hexadecimal-output">Hexadecimal</label>
                <div id="hexadecimal-output" class="output-value">00000000</div>
                <button class="copy-button" type="button" aria-label="Copy">
                    <MorphIcon icon={Copy} color="lightgray" />
                </button>
            </div>

            <div class="output">
                <label for="base36-output">Base36</label>
                <div id="base36-output" class="output-value">00000000</div>
                <button class="copy-button" type="button" aria-label="Copy">
                    <MorphIcon icon={Copy} color="lightgray" />
                </button>
            </div>
        </div>
    </div>
</Layout>

<style>
    label {
        font-size: 14px;
        color: white;
    }

    input {
        width: 220px;

        padding: 10px;

        outline: none;

        border-radius: 12px;
        border: 1px solid #252525;

        background-color: #191919;
        color: white;

        font-size: 14px;
        font-family: "IBM Plex Mono", monospace;
    }

    textarea {
        height: auto;
        min-width: 220px;
        max-width: 220px;
        field-sizing: content;

        padding: 10px;

        outline: none;

        border-radius: 12px;
        border: 1px solid #252525;

        background-color: #191919;
        color: white;

        font-size: 14px;
        font-family: "IBM Plex Mono", monospace;
    }

    .inputs-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .inputs {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .outputs {
        display: flex;
        flex-direction: column;

        gap: 10px;
        margin-top: 32px;
    }

    .output {
        display: flex;
        flex-direction: column;
        gap: 6px;
        overflow-wrap: break-word;
        position: relative;
        color: #dadada;
    }

    .copy-button {
        position: absolute;
        top: 30px;
        right: 6px;

        width: 30px;
        height: 30px;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 6px;

        border: none;
        border-radius: 8px;

        background: #252525;
        box-shadow: -4px 4px 4px 0px #141414;

        opacity: 0;

        cursor: pointer;
        transition: opacity 0.15s ease-in-out;
    }

    .output:hover .copy-button {
        opacity: 1;
    }

    .copy-button:hover {
        background: #303030;
    }

    .output-value {
        background-color: #141414;
        border: 1px solid #191919;
        padding: 10px;
        width: 220px;
        border-radius: 12px;
        font-size: 14px;
        min-height: 17px;
    }
</style>
<script>
    //morph icons
    import { Convertor } from "../scripts/Convertor";
    import { Copy, Check } from "lucide";
    import type { MorphIconElement } from "morphicons/element";

    const copyButtons: HTMLCollectionOf<HTMLButtonElement> =
        document.getElementsByClassName(
            "copy-button",
        )! as HTMLCollectionOf<HTMLButtonElement>;

    for (let i: number = 0; i < copyButtons.length; i++) {
        const icon =
            copyButtons[i].querySelector<MorphIconElement>("morph-icon")!;

        copyButtons[i].addEventListener("click", async () => {
            CopyToClipboard(
                copyButtons[i].parentElement?.getElementsByClassName(
                    "output-value",
                )![0].textContent!,
            );
            icon.icon = Check;
            await Sleep(1000);
            icon.icon = Copy;
        });
    }

    const numberInput: HTMLInputElement = document.getElementById(
        "number-input",
    )! as HTMLInputElement;
    const baseInput: HTMLInputElement = document.getElementById(
        "base-input",
    )! as HTMLInputElement;
    const binaryOutput = document.getElementById("binary-output")!;
    const octalOutput = document.getElementById("octal-output")!;
    const decimalOutput = document.getElementById("decimal-output")!;
    const hexOutput = document.getElementById("hexadecimal-output")!;
    const base36Output = document.getElementById("base36-output")!;

    RefreshConvertors(); //Initial refresh to keep data up to date on load

    numberInput.addEventListener("input", RefreshConvertors);
    baseInput.addEventListener("input", RefreshConvertors);

    function RefreshConvertors() {
        let input: string = numberInput.value;
        let inputBase: number = parseInt(baseInput.value);

        let binary: string = Convertor.BaseToBase(input, inputBase, 2);
        let hex: string = Convertor.BaseToBase(input, inputBase, 16);
        if (binary !== "NaN") {
            //Binary special formatting
            let fixedBinary: string = "";
            let currentByte: string = "";
            for (let i: number = binary.length - 1; i >= 0; i--) {
                currentByte = binary[i] + currentByte;
                if (currentByte.length === 8 || i === 0) {
                    fixedBinary =
                        currentByte.padStart(8, "0") +
                        (fixedBinary.length > 0 ? " " : "") +
                        fixedBinary;
                    currentByte = "";
                }
            }

            //Hexadecimal special formatting
            let fixedHex: string = "";
            let currentHexByte: string = "";
            for (let i: number = hex.length - 1; i >= 0; i--) {
                currentHexByte = hex[i] + currentHexByte;
                if (currentHexByte.length === 2 || i === 0) {
                    fixedHex =
                        currentHexByte.padStart(2, "0") +
                        (fixedHex.length > 0 ? " " : "") +
                        fixedHex;
                    currentHexByte = "";
                }
            }

            binaryOutput.textContent = fixedBinary;
            hexOutput.textContent = fixedHex.toUpperCase();
            base36Output.textContent = Convertor.BaseToBase(
                input,
                inputBase,
                36,
            ).toUpperCase();
        } else {
            binaryOutput.textContent = binary;
            hexOutput.textContent = hex;
            base36Output.textContent = "NaN";
        }

        octalOutput.textContent = Convertor.BaseToBase(input, inputBase, 8);
        decimalOutput.textContent = Convertor.BaseToBase(input, inputBase, 10);
    }

    function CopyToClipboard(text: string) {
        navigator.clipboard.writeText(text);
    }

    async function Sleep(ms: number) {
        await new Promise((r) => setTimeout(r, ms));
    }
</script>
