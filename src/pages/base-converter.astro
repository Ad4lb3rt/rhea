---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div class="content">
        <div class="inputs-container">
            <div class="inputs">
                <label for="number-input">input</label>
                <input id="number-input" />
            </div>
            <div class="inputs">
                <label for="base-input">base</label>
                <input id="base-input" type="number" />
            </div>
        </div>

        <div class="outputs">
            <div class="output">
                <label for="binary-output">Binary</label>
                <div id="binary-output" class="output-value">00000000</div>
            </div>

            <div class="output">
                <label for="octal-output">Octal</label>
                <div id="octal-output" class="output-value">00000000</div>
            </div>

            <div class="output">
                <label for="decimal-output">Decimal</label>
                <div id="decimal-output" class="output-value">00000000</div>
            </div>

            <div class="output">
                <label for="hexadecimal-output">Hexadecimal</label>
                <div id="hexadecimal-output" class="output-value">00000000</div>
            </div>

            <div class="output">
                <label for="base36-output">Base36</label>
                <div id="base36-output" class="output-value">00000000</div>
            </div>
        </div>
    </div>
</Layout>

<style>
    label {
        font-size: 14px;
        color: white;
    }

    input {
        width: 200px;

        padding: 10px;

        outline: none;

        border-radius: 12px;
        border: 1px solid #252525;

        background-color: #191919;
        color: white;

        font-size: 14px;
    }

    .inputs-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .inputs {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .outputs {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 32px;
    }

    .output {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .output-value {
        background-color: #141414;
        border: 1px solid #191919;
        padding: 10px;
        width: 200px;
        border-radius: 12px;
        font-size: 14px;
        height: 17px;
    }
</style>
